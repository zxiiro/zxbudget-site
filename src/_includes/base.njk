<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
(function () {
  try {
    var choice = localStorage.getItem("zxbudget-theme");
    if (choice === "light" || choice === "dark") {
      document.documentElement.dataset.theme = choice;
    }
  } catch (e) {}
})();
</script>
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <a class="wordmark" href="/"><img class="mark" src="/icons/icon-192.png" width="32" height="32" alt=""> ZxBudget</a>
  <div class="header-end">
    <nav class="nav" aria-label="Site">
      <a href="/guides/"{% if nav == "guides" %} aria-current="page"{% endif %}>Guides</a>
      <a href="/support.html"{% if nav == "support" %} aria-current="page"{% endif %}>Support</a>
      <a href="/privacy.html"{% if nav == "privacy" %} aria-current="page"{% endif %}>Privacy</a>
    </nav>
    <button type="button" class="theme-toggle" aria-label="Switch to dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"/>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"/>
      </svg>
    </button>
  </div>
</header>
<p class="soon-banner">Coming soon to the App Store.</p>
<main id="content">
{{ content | safe }}
</main>
<footer>
  <div class="inner">
    <div>ZxBudget · <a href="mailto:zxiiro@gmail.com">zxiiro@gmail.com</a></div>
    <div>
      <a href="/guides/">Guides</a>
      <a href="/support.html">Support</a>
      <a href="/privacy.html">Privacy</a>
    </div>
  </div>
</footer>
<script>
(function () {
  var key = "zxbudget-theme";
  var root = document.documentElement;
  var button = document.querySelector(".theme-toggle");
  if (!button) return;

  function isDark() {
    if (root.dataset.theme === "dark") return true;
    if (root.dataset.theme === "light") return false;
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function label() {
    button.setAttribute("aria-label", isDark() ? "Switch to light mode" : "Switch to dark mode");
  }

  function apply(choice) {
    root.dataset.theme = choice;
    try { localStorage.setItem(key, choice); } catch (e) {}
    label();
  }

  button.addEventListener("click", function () {
    apply(isDark() ? "light" : "dark");
  });
  label();
})();
</script>
</body>
</html>
